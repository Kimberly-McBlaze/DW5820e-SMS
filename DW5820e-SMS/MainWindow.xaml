<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DW5820e_SMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DW5820e_SMS"
    xmlns:models="using:DW5820e_SMS.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DW5820e SMS">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header / Account selector -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Account:" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                <ComboBox x:Name="AccountCombo"
                          MinWidth="280"
                          PlaceholderText="Select Mobile Broadband account…"
                          SelectionChanged="AccountCombo_SelectionChanged"/>
                <ProgressRing x:Name="AccountProgress" IsActive="False" Width="20" Height="20"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Export CSV" Margin="4,0,0,0"
                    Click="ExportCsvButton_Click" ToolTipService.ToolTip="Save all messages as CSV"/>
            <Button Grid.Column="2" Content="Export JSON" Margin="4,0,0,0"
                    Click="ExportJsonButton_Click" ToolTipService.ToolTip="Save all messages as JSON"/>
            <Button Grid.Column="3" Content="↻ Refresh" Margin="4,0,0,0"
                    Click="RefreshButton_Click" ToolTipService.ToolTip="Reload message history from database"/>
        </Grid>

        <!-- Message list -->
        <ListView x:Name="MessageList"
                  Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SmsMessage">
                    <Grid ColumnDefinitions="80,120,*,80,80" Padding="4,6">
                        <TextBlock Grid.Column="0" Text="{x:Bind DirectionLabel}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind PhoneNumber}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Body}" Margin="8,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="3"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   Text="{x:Bind Timestamp}"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind StatusLabel}"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Header>
                <Grid ColumnDefinitions="80,120,*,80,80"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      Padding="4,4">
                    <TextBlock Grid.Column="0" Text="Dir" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Phone" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Body" FontWeight="SemiBold" Margin="8,0"/>
                    <TextBlock Grid.Column="3" Text="Time" FontWeight="SemiBold" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" TextAlignment="Right"/>
                </Grid>
            </ListView.Header>
        </ListView>

        <!-- Compose area -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4" Padding="12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="120,*,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="To (phone number):"
                           VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBox x:Name="ToBox" Grid.Row="0" Grid.Column="1" Margin="8,0"
                         PlaceholderText="+1XXXXXXXXXX"
                         InputScope="TelephoneNumber"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Message:" Margin="0,8,0,0"
                           VerticalAlignment="Top" Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBox x:Name="BodyBox" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0"
                         PlaceholderText="Type a message…"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"/>
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            Orientation="Vertical" VerticalAlignment="Center" Spacing="6" Margin="8,0,0,0">
                    <Button x:Name="SendButton" Content="Send ➤"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SendButton_Click"/>
                    <ProgressRing x:Name="SendProgress" IsActive="False" Width="24" Height="24"
                                  HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
